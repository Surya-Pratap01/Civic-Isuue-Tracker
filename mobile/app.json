{
  "expo": {
    "name": "Jharkhand Civic Reporter",
    "slug": "jharkhand-civic-reporter",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "civicreporter",
    "userInterfaceStyle": "automatic",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "This app uses the microphone to record an optional voice note while reporting an issue."
      }
    },
    "android": {
      "permissions": [
        "RECORD_AUDIO"
      ],
      "usesCleartextTraffic": true
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
